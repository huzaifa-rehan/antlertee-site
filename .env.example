# Antlertee site: environment variables.
# Copy to .env.local for local overrides (never commit .env.local). On Vercel, set these in
# Project -> Settings -> Environment Variables (see docs/go-live.md).
#
# LOCAL DEVELOPMENT NEEDS NONE OF THESE: `npm run dev` without them uses an embedded Postgres in .data/pglite,
# stores uploads in .data/uploads, and logs in with the dev-only credentials below.
# PRODUCTION (`next build` / `next start` / Vercel) REQUIRES ALL OF THEM and fails loudly when one is missing.

# --- Database: Neon Postgres (Vercel Marketplace -> Neon). Run `npm run db:migrate` after setting it.
DATABASE_URL=

# --- Files: Vercel Blob, two stores.
# Public store: replaced site images and the media library.
BLOB_READ_WRITE_TOKEN=
# Private store: customer tech pack / quote files. Only readable through the logged-in admin.
LEADS_BLOB_READ_WRITE_TOKEN=

# --- Admin login (one admin user).
# Preferred: a scrypt hash from `npm run admin:hash` (the plain password is then stored nowhere).
ADMIN_PASSWORD_HASH=
# Alternative: a plain password (ignored when ADMIN_PASSWORD_HASH is set).
ADMIN_PASSWORD=
# Random string, at least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
SESSION_SECRET=

# Optional: salt for the hashed client IPs used by rate limits (defaults to SESSION_SECRET).
IP_HASH_SALT=

# Optional: public site URL used in canonical links, Open Graph and the sitemap (build time).
NEXT_PUBLIC_SITE_URL=

# --- DEV-ONLY DEFAULTS (used by `npm run dev` when the variables above are empty; refused in production) ---
#   admin password:  antlertee-dev-only
#   SESSION_SECRET:  dev-only-session-secret-do-not-use-in-production
