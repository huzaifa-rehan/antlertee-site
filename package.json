{
  "name": "antlertee-site",
  "version": "1.0.0",
  "private": true,
  "description": "Antlertee Creative Studios: production website (Next.js static export).",
  "scripts": {
    "dev": "next dev --port 5192 --hostname 127.0.0.1",
    "build": "next build",
    "start": "python -m http.server 5192 --bind 127.0.0.1 --directory out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/build-images.mjs",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "motion": "14.12.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
